GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# path to the service-account JSON key (share the calendar + sheet with its client_email)
GOOGLE_SA_JSON=./service-account.json
CALENDAR_ID=xxxxxxxx@group.calendar.google.com
SHEET_ID=
# Phase 2: public https URL of this server (e.g. cloudflared tunnel), no trailing slash
PUBLIC_URL=https://xxxx.trycloudflare.com
VAPI_SECRET=
VAPI_MODEL=gemini-3.8-flash
VAPI_VOICE=Elliot
PORT=3000

# Optional: run Gemini through Vertex AI (billed to that GCP project) instead of GEMINI_API_KEY
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_SA_KEY=./vertex-sa.json
