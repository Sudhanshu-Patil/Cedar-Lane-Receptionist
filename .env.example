GEMINI_API_KEY=
# Optional: use Vertex AI (billed to a GCP project) instead of GEMINI_API_KEY
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_SA_KEY=./vertex-sa.json

# Service-account JSON key; share the calendar and sheet with its client_email
GOOGLE_SA_JSON=./service-account.json
CALENDAR_ID=xxxxxxxx@group.calendar.google.com
SHEET_ID=

# Phase 2: public https URL of this server (e.g. cloudflared tunnel), no trailing slash
PUBLIC_URL=https://xxxx.trycloudflare.com
VAPI_SECRET=
VAPI_API_KEY=
# website browser calls (Vapi dashboard -> API Keys -> public key)
VAPI_PUBLIC_KEY=
PORT=3000
